# انسخ هذا الملف باسم .env على السيرفر فقط (لا تحتاجه محليًا، القيم الافتراضية تكفي للتطوير)
# ولا ترفع .env الحقيقي إلى Git أبدًا

# أنشئ مفتاحًا جديدًا محليًا بالأمر:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ضع-هنا-مفتاحًا-عشوائيًا-جديدًا

DEBUG=False

# اسم نطاق السيرفر بدون https:// وبدون شرطة مائلة في النهاية
ALLOWED_HOSTS=username.pythonanywhere.com

# رابط الواجهة الأمامية المنشورة (Vercel/Netlify) بدون شرطة مائلة في النهاية
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app
